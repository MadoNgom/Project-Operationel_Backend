# Configuration de la base de données PostgreSQL (externe sur votre VPS)
DATABASE_URL=jdbc:postgresql://locahost:5432/flux-transaction-v1
DATABASE_USERNAME=admin
DATABASE_PASSWORD=admin_password

# Configuration JWT (changez ces valeurs en production !)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# Configuration de l'application
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Configuration de la JVM
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC -XX:+UseContainerSupport

# Configuration de la base de données
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_SHOW_SQL=false

# Configuration Swagger
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true

# Configuration Actuator
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=when_authorized
